{%- comment -%}
==============================================
Initialize global variables and mappings
==============================================
{%- endcomment -%}

{%- comment -%}Format upper class name{%- endcomment -%}
{%- capture upper_klass_name -%}
{{ klass.generalization.general.name }}
{%- endcapture -%}
{%- if upper_klass_name == "" -%}
  {%- assign upper_klass_name = "&#x2014;" -%}
{%- endif -%}

{%- comment -%}Format stereotype{%- endcomment -%}
{%- capture stereotype -%}«{{ klass.stereotype }}»{%- endcapture -%}
{%- if stereotype == "«»" -%}
  {%- assign stereotype = " " -%}
{%- endif -%}

{% assign owned_props = klass.owned_attributes %}

{%- comment -%}Configure table columns{%- endcomment -%}
{%- assign guidance_column = false -%}
{%- assign guidance_row_style = "tr-style:[background-color: lightyellow]" -%}
{%- if klass.has_guidance? and guidance_column -%}
  {%- assign cols_format = "1a,1a,2a,1a" -%}
  {%- assign cols_number = 4 -%}
  {%- assign cols_header = 3 -%}
{%- else -%}
  {%- assign cols_format = "1a,1a,2a" -%}
  {%- assign cols_number = 3 -%}
  {%- assign cols_header = 2 -%}
{%- endif -%}

[cols="{{ cols_format }}"]
|===
h| 型の定義 {{ cols_header }}+| {{ klass.definition }}
h| 上位の型 {{ cols_header }}+| {{ upper_klass_name }}
h| ステレオタイプ {{ cols_header }}+| {{ stereotype }}

{% if owned_props.size > 0 %}
{{ cols_number }}+h| 自身に定義された属性
h| 属性名 h| 属性の型及び多重度 h| 定義 {% if klass.has_guidance? and guidance_column -%} h| 補足{%- endif %}
{% for attr in owned_props %}
  {% assign attr_cardinality = attr.cardinality.min | append: '..' | append: attr.cardinality.max %}
  {% if attr_cardinality == '..*' %}
    {% assign attr_cardinality = '0..*' %}
  {% endif %}
| {{ attr.name }}
| {{ attr.type }} {% if attr.cardinality %}[{{ attr_cardinality }}]{% endif %}
| {{ attr.definition | html2adoc }}
{% if klass.has_guidance? and guidance_column -%} | {{ attr.guidance }}{%- endif %}{% if klass.has_guidance? and attr.guidance and attr.used? == "true" %}{{ guidance_row_style }}{% endif %}
{% endfor %}
{% endif %}
|===
